# Configure estes valores nas Environment Variables do Vercel
# (Project → Settings → Environment Variables), NÃO commite o .env real.

# Beehiiv — usado pela função /api/subscribe
BEEHIIV_API_KEY=coloque_sua_api_key_aqui
BEEHIIV_PUB_ID=pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Upstash KV (conectado via Vercel Storage) — backup de todo lead recebido,
# injetadas automaticamente quando o banco é conectado ao projeto.
KV_REST_API_URL=https://xxxxxxx.upstash.io
KV_REST_API_TOKEN=coloque_o_token_aqui

# Senha pra acessar /api/leads?key=... e ver/exportar os e-mails salvos
LEADS_ADMIN_KEY=escolha_uma_senha_forte_aqui
